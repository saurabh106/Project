generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique
  email     String     @unique
  firstName String?
  lastName  String?
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Contract {
  id            String         @id @default(cuid())
  name          String
  fileUrl       String
  extractedText String?        @db.Text
  status        ContractStatus @default(PENDING)
  userId        String
  user          User           @relation(fields: [userId], references: [clerkId])
  analysis      Json?          // For storing AI analysis results later
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

enum ContractStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVIEW
}
